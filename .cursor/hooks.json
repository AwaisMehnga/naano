{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/capture-agent-log.py",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/capture-agent-log.py",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/capture-agent-log.py",
        "timeout": 10
      }
    ]
  }
}
